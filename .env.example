# ============================================================
# Chasher-Disha — environment variable template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# Django core  (required)
DJANGO_SECRET_KEY=                    # generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=True                            # set False in production
ALLOWED_HOSTS=127.0.0.1,localhost     # comma-separated; add your domain in production

# CORS — origins allowed to call the REST API  (M3 / required for React SPA / M6)
CORS_ALLOWED_ORIGINS=http://localhost:5173   # React dev server; add production URL later

# Fertilizer API  (M5)
FERTILIZER_USE_MOCK=True              # True = rule-based mock; False = real API
FERTILIZER_API_KEY=                   # leave blank until real API is chosen
FERTILIZER_API_URL=                   # leave blank until real API is chosen

# YOLO model weights download  (M4 / optional)
MODEL_DOWNLOAD_URL=                   # direct HTTPS URL to rice_disease.pt (set after training)
MODEL_ONNX_DOWNLOAD_URL=              # direct HTTPS URL to rice_disease.onnx (optional)

# ============================================================
# NOT needed — removed in M0/M4:
#   OPENWEATHER_API_KEY  → replaced by Open-Meteo (no key required)
#   ROBOFLOW_API_KEY     → replaced by local YOLOv8-nano model
#   ROBOFLOW_MODEL       → replaced by local YOLOv8-nano model
#   ROBOFLOW_VERSION     → replaced by local YOLOv8-nano model
# ============================================================

