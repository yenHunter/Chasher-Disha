# Python
###################
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environment
###################
venv/
env/
.venv/
.env/
activate

# Django
###################
# Ignore the default development database
db.sqlite3
db.sqlite3-journal

# Ignore local settings and secret files
local_settings.py
.env
.env.*
!.env.example

# ML model weights (too large for Git — download via scripts/download_model.py)
chatbot_app/ml/models/*.pt
chatbot_app/ml/models/*.onnx

# YOLO training runs (large artefacts — keep locally, not in repo)
train/runs/
train/datasets/

# Collected static files
staticfiles/

# React / Node
web/node_modules/
web/dist/
web/.env
web/.env.*
!web/.env.example

# Ignore user-uploaded files (MEDIA_ROOT)
media/

# Ignore collected static files (STATIC_ROOT)
# NOTE: If your STATIC_ROOT is named 'static' instead of 'staticfiles',
# change the line below to 'static/'
staticfiles/

# Log files
*.log
logs/

# Django-extensions shell history
.shell_history

# Coverage reports
###################
.coverage
.coverage.*
htmlcov/
*.cover

